#: includes/class-segurium-scan-runner.php:1359
#: includes/class-segurium.php:1100 includes/class-segurium.php:3792
#: includes/class-segurium.php:3857 includes/class-segurium.php:3884
#: includes/class-segurium.php:4721
msgid "You do not have permission to manage scans."
msgstr "Sinulla ei ole oikeutta hallinnoida tarkistuksia."

#: includes/class-segurium-scan-runner.php:1389
#: includes/class-segurium.php:4749
msgid "Could not fetch scan status due to a server error."
msgstr "Tarkistuksen tilaa ei voitu hakea palvelinvirheen vuoksi."

#. translators: %d: max_execution_time in seconds
#: includes/class-segurium-scan-runner.php:2316
#, php-format
msgid ""
"PHP max_execution_time is %ds — too short for reliable scanning. Ask your "
"host to raise it to at least 30s."
msgstr ""
"PHP:n max_execution_time on %d s — liian lyhyt luotettavaan tarkistukseen. "
"Pyydä palveluntarjoajaasi nostamaan se vähintään 30 sekuntiin."

#: includes/class-segurium-scan-runner.php:2327
msgid ""
"WordPress cron is disabled (DISABLE_WP_CRON) and your PHP setup has no way "
"to detach long tasks from page requests. Background scans will only progress"
" while a Segurium admin tab stays open. Ask your host to either enable a "
"real system cron job hitting wp-cron.php every minute, or to switch from "
"mod_php to PHP-FPM / LiteSpeed."
msgstr ""
"WordPressin cron on poistettu käytöstä (DISABLE_WP_CRON), eikä PHP-"
"asetuksissasi ole tapaa irrottaa pitkiä tehtäviä sivupyynnöistä. "
"Taustatarkistukset etenevät vain niin kauan kuin Seguriumin "
"hallintavälilehti pysyy auki. Pyydä palveluntarjoajaasi joko ottamaan "
"käyttöön oikea järjestelmän ajastettu tehtävä, joka kutsuu wp-cron.php:tä "
"minuutin välein, tai vaihtamaan mod_php:stä PHP-FPM:ään tai LiteSpeediin."

#: includes/class-segurium-scan-runner.php:2329
msgid ""
"WordPress cron is disabled (DISABLE_WP_CRON). Scheduled scans depend on a "
"real system cron job hitting wp-cron.php every minute. Ask your host to set "
"one up."
msgstr ""
"WordPressin cron on poistettu käytöstä (DISABLE_WP_CRON). Ajastetut "
"tarkistukset tarvitsevat oikean järjestelmän ajastetun tehtävän, joka kutsuu"
" wp-cron.php:tä minuutin välein. Pyydä palveluntarjoajaasi määrittämään "
"sellainen."

#: includes/class-segurium-scan-trigger-auth.php:93

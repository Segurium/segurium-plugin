msgstr "[%s] Ο κωδικός επαλήθευσης σύνδεσής σας"

#. translators: 1: verification code, 2: TTL in minutes
#: includes/class-segurium-2fa.php:1186
#, php-format
msgid ""
"Your verification code is: %1$s\n"
"\n"
"This code expires in %2$d minutes.\n"
"\n"
"If you did not request this, ignore this email."
msgstr ""
"Ο κωδικός επαλήθευσής σας είναι: %1$s\n"
"\n"
"Ο κωδικός λήγει σε %2$d λεπτά.\n"
"\n"
"Αν δεν το ζητήσατε εσείς, αγνοήστε αυτό το email."


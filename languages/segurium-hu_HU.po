msgstr "Ismétlődő kártevővizsgálat van ütemezve."

#: includes/class-segurium-self-check.php:972
msgid "No recurring malware scan is scheduled."
msgstr "Nincs ütemezve ismétlődő kártevővizsgálat."

#: includes/class-segurium-self-check.php:984

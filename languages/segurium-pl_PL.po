msgstr "Permissions-Policy ogranicza dostęp do funkcji przeglądarki."

#: includes/class-segurium-self-check.php:354
msgid "Missing Permissions-Policy. Browser features are not restricted."
msgstr ""
"Brak nagłówka Permissions-Policy. Funkcje przeglądarki nie są ograniczone."

#: includes/class-segurium-self-check.php:366 includes/class-segurium.php:2133
msgid "X-XSS-Protection"

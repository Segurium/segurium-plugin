#: includes/class-segurium-self-check.php:952 includes/class-segurium.php:3069
msgid "Cloud-assisted malware detection"
msgstr "Felhőalapú kártevőészlelés"

#: includes/class-segurium-self-check.php:955
msgid ""
"On-premise mode is enabled: file contents stay on this server, and any file "
"the cloud cannot identify by hash goes unresolved. Turn on cloud-assisted "
"detection for full accuracy."
msgstr ""
"A helyben futó mód be van kapcsolva: a fájlok tartalma ezen a kiszolgálón "
"marad, és minden fájl eldöntetlen marad, amelyet a felhő hash alapján nem "
"tud azonosítani. A teljes pontossághoz kapcsoljuk be a felhőalapú észlelést."

#: includes/class-segurium-self-check.php:956
msgid "Cloud-assisted malware detection is active."
msgstr "A felhőalapú kártevőészlelés aktív."

#: includes/class-segurium-self-check.php:968
msgid "Scheduled malware scans"
msgstr "Ütemezett kártevővizsgálatok"

#: includes/class-segurium-self-check.php:971

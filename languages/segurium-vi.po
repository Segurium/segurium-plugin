#. Plugin Name of the plugin
#: segurium.php
msgid ""
"Segurium – Malware Removal & Cleanup, Firewall, Two-Factor Authentication"
msgstr "Segurium – Gỡ bỏ và dọn dẹp mã độc, tường lửa, xác thực hai yếu tố"

#. Plugin URI of the plugin
#: segurium.php
msgid "https://segurium.com"
msgstr "https://segurium.com"

#. Description of the plugin
#: segurium.php
msgid ""
"Site hacked? Free WordPress malware removal: scan, clean infected files, "
"restore them. Plus firewall, brute-force protection, 2FA, geo-blocking."
msgstr ""
"Trang web bị hack? Diệt mã độc WordPress miễn phí: quét, làm sạch tệp nhiễm,"
" khôi phục. Kèm tường lửa, chống brute force, 2FA, chặn theo quốc gia."


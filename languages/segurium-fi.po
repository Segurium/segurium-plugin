msgstr ""
"Tarkistusten tallennustila ei ole valmis. Poista Segurium-lisäosa käytöstä, "
"ota se uudelleen käyttöön ja yritä sitten uudelleen."

#: includes/class-segurium-scan-runner.php:448
#: includes/class-segurium-scan-runner.php:486
#: includes/class-segurium.php:1096
msgid "A scan is already in progress."
msgstr "Tarkistus on jo käynnissä."

#. translators: %s: underlying exception message
#: includes/class-segurium-scan-runner.php:479
#: includes/class-segurium-scan-runner.php:555
#, php-format
msgid "Unexpected error starting scan: %s"
msgstr "Odottamaton virhe tarkistusta aloitettaessa: %s"

#: includes/class-segurium-scan-runner.php:507
msgid ""
"Scan storage was not ready. It has been repaired automatically — please "
"click \"Start scan\" again."
msgstr ""
"Tarkistusten tallennustila ei ollut valmis. Se korjattiin automaattisesti — "
"napsauta \"Aloita tarkistus\" uudelleen."

#. translators: %s: underlying exception message

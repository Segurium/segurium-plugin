msgstr "Segurium Cloud (%s): antetul semnăturii are un format greșit."

#. translators: %s: endpoint label
#: includes/class-segurium-cti-signature.php:163
msgid "Segurium Cloud (%s): signature timestamp malformed."
msgstr "Segurium Cloud (%s): datarea semnăturii are un format greșit."

#. translators: 1: endpoint label, 2: skew in seconds
#: includes/class-segurium-cti-signature.php:176
msgid ""
"Segurium Cloud (%1$s): signature timestamp is %2$d seconds out of range."
msgstr ""
"Segurium Cloud (%1$s): datarea semnăturii este cu %2$d secunde în afara "
"intervalului."

#. translators: 1: endpoint label, 2: error message
#: includes/class-segurium-cti-signature.php:193

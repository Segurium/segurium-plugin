msgstr "Túl sok sikertelen bejelentkezési kísérlet. Új próbálkozás %s múlva."

#: includes/class-segurium-brute-force.php:1488
msgid "Login Locked"
msgstr "Bejelentkezés zárolva"

#: includes/class-segurium-cleanup.php:89
msgid "Verdict has no defined cleanup recipe."
msgstr "Az ítélethez nincs meghatározott tisztítási recept."

#: includes/class-segurium-cleanup.php:93
msgid "File not found."
msgstr "A fájl nem található."

#: includes/class-segurium-cleanup.php:98 includes/class-segurium.php:6684
msgid "File has been modified since scan. Re-scan first."
msgstr "A fájl a vizsgálat óta módosult. Előbb új vizsgálat szükséges."

#: includes/class-segurium-cleanup.php:103
msgid "Failed to read file for backup."
msgstr "A fájl beolvasása biztonsági mentéshez nem sikerült."

#: includes/class-segurium-cleanup.php:121
msgid "Failed to create backup."
msgstr "A biztonsági mentés létrehozása nem sikerült."

#: includes/class-segurium-cleanup.php:161
msgid "Failed to clean file."
msgstr "A fájl tisztítása nem sikerült."

#: includes/class-segurium-component-backup.php:50
#: includes/class-segurium.php:5270
msgid "Component directory not found."
msgstr "Az összetevő könyvtára nem található."

#: includes/class-segurium-component-backup.php:53
msgid "Invalid component type."
msgstr "Érvénytelen összetevőtípus."

#: includes/class-segurium-component-backup.php:56
msgid "Invalid component slug."
msgstr "Érvénytelen összetevő-azonosító."

#: includes/class-segurium-component-backup.php:59
#: includes/class-segurium-component-backup.php:168
msgid "The PHP Phar extension is required for component backups."
msgstr ""
"Az összetevők biztonsági mentéséhez a PHP Phar kiterjesztés szükséges."

#. translators: %s: underlying error message.
#: includes/class-segurium-component-backup.php:80
msgid "Backup failed: %s"
msgstr "A biztonsági mentés nem sikerült: %s"

#: includes/class-segurium-component-backup.php:92

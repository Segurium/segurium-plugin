#: includes/class-segurium.php:2843
msgid "Same origin"
msgstr "Origin yang sama"

#: includes/class-segurium.php:2754
msgid "Deny all"
msgstr "Tolak semua"

#: includes/class-segurium.php:2756
msgid "Prevents your site from being embedded in iframes on other domains."
msgstr "Mencegah situs Anda ditanam dalam iframe di domain lain."


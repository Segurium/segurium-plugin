#: includes/class-segurium-self-check.php:369
msgid "Legacy XSS filter directive present."
msgstr "Obecna jest dyrektywa starszego filtra XSS."

#: includes/class-segurium-self-check.php:370
msgid ""
"Missing X-XSS-Protection. Set to 0 to disable legacy browser XSS filters "

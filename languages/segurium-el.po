msgstr "Ο κατάλογος προορισμού της επαναφοράς δεν είναι εγγράψιμος."

#. translators: %s: underlying error message.
#: includes/class-segurium-component-backup.php:209
#, php-format
msgid "Restore failed: %s"
msgstr "Η επαναφορά απέτυχε: %s"

#: includes/class-segurium-component-backup.php:243
msgid "Secure randomness is unavailable on this host."
msgstr "Η ασφαλής τυχαιότητα δεν είναι διαθέσιμη σε αυτόν τον εξυπηρετητή."

#: includes/class-segurium-cti-client.php:235
msgid ""
"Installation ID unavailable. Please ensure the plugin is properly activated."
msgstr ""
"Το αναγνωριστικό εγκατάστασης δεν είναι διαθέσιμο. Βεβαιωθείτε ότι το "
"πρόσθετο έχει ενεργοποιηθεί σωστά."

#: includes/class-segurium-cti-client.php:610
msgid "Too many requests. Please try again later."
msgstr "Πάρα πολλά αιτήματα. Δοκιμάστε ξανά αργότερα."

#. translators: %d: HTTP status code
#: includes/class-segurium-cti-client.php:616
#, php-format
msgid "Support service error (HTTP %d)."
msgstr "Σφάλμα υπηρεσίας υποστήριξης (HTTP %d)."

#: includes/class-segurium-cti-client.php:1445
msgid "Cleanup quota reached."
msgstr "Συμπληρώθηκε το όριο καθαρισμών."

#: includes/class-segurium-cti-client.php:1452
msgid "Clean version not available for this file"
msgstr "Δεν υπάρχει διαθέσιμη καθαρή έκδοση για αυτό το αρχείο"

#: includes/class-segurium-cti-client.php:1854
msgid "Invalid billing response from Segurium Cloud."
msgstr "Μη έγκυρη απάντηση χρέωσης από το Segurium Cloud."

#. translators: %s: endpoint label
#: includes/class-segurium-cti-signature.php:88
#, php-format
msgid "Segurium Cloud (%s): no response to verify."
msgstr "Segurium Cloud (%s): δεν υπάρχει απάντηση προς επαλήθευση."

#. translators: %s: endpoint label
#: includes/class-segurium-cti-signature.php:120
#, php-format
msgid "Segurium Cloud (%s): missing signature headers."
msgstr "Segurium Cloud (%s): λείπουν οι κεφαλίδες υπογραφής."

#. translators: 1: endpoint label, 2: key id from the signature header
#: includes/class-segurium-cti-signature.php:130
#, php-format
msgid "Segurium Cloud (%1$s): signed with an untrusted key \"%2$s\"."
msgstr "Segurium Cloud (%1$s): υπογράφηκε με μη έμπιστο κλειδί «%2$s»."

#: includes/class-segurium-cti-signature.php:141
msgid "Signature trust list is corrupt — public key failed to decode."
msgstr ""
"Η λίστα έμπιστων υπογραφών είναι κατεστραμμένη — το δημόσιο κλειδί δεν "
"αποκωδικοποιήθηκε."

#. translators: %s: endpoint label
#: includes/class-segurium-cti-signature.php:151
#, php-format
msgid "Segurium Cloud (%s): signature header malformed."
msgstr "Segurium Cloud (%s): η κεφαλίδα υπογραφής είναι κακοδιατυπωμένη."

#. translators: %s: endpoint label
#: includes/class-segurium-cti-signature.php:162
#, php-format
msgid "Segurium Cloud (%s): signature timestamp malformed."
msgstr ""
"Segurium Cloud (%s): η χρονοσήμανση της υπογραφής είναι κακοδιατυπωμένη."

#. translators: 1: endpoint label, 2: skew in seconds
#: includes/class-segurium-cti-signature.php:175
#, php-format
msgid ""
"Segurium Cloud (%1$s): signature timestamp is %2$d seconds out of range."
msgstr ""
"Segurium Cloud (%1$s): η χρονοσήμανση της υπογραφής είναι %2$d δευτερόλεπτα "
"εκτός εύρους."

#. translators: 1: endpoint label, 2: error message
#: includes/class-segurium-cti-signature.php:192

#. Plugin Name of the plugin
#: segurium.php
msgid ""
"Segurium – Malware Removal & Cleanup, Firewall, Two-Factor Authentication"
msgstr ""
"Segurium – Malware Removal & Cleanup, Firewall, Two-Factor Authentication"

#. Plugin URI of the plugin
#: segurium.php
msgid "https://segurium.com"
msgstr "https://segurium.com"

#. Description of the plugin
#: segurium.php
msgid ""
"Site hacked? Free WordPress malware removal: scan, clean infected files, "
"restore them. Plus firewall, brute-force protection, 2FA, geo-blocking."
msgstr ""
"Webbplatsen hackad? Kostnadsfri borttagning av skadlig kod för WordPress: "
"skanna, rensa infekterade filer, återställ dem. Plus brandvägg, skydd mot "
"brute force, 2FA, geoblockering."


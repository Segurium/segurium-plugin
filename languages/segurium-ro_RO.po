msgstr "Protecție împotriva clickjacking prin X-Frame-Options."

#: includes/class-segurium-self-check.php:460
msgid "Missing X-Frame-Options. Site may be framed by attackers."
msgstr ""
"Lipsește X-Frame-Options. Site-ul poate fi o victimă pentru atacatori."

#: includes/class-segurium-self-check.php:472 includes/class-segurium.php:2578
msgid "Referrer-Policy"
msgstr "Referrer-Policy"

#: includes/class-segurium-self-check.php:475

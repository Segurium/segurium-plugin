#. Plugin Name of the plugin
#: segurium.php
msgid ""
"Segurium – Malware Removal & Cleanup, Firewall, Two-Factor Authentication"
msgstr "Segurium – Kártevőirtás és tisztítás, tűzfal, kétlépcsős hitelesítés"

#. Plugin URI of the plugin
#: segurium.php
msgid "https://segurium.com"
msgstr "https://segurium.com"

#. Description of the plugin
#: segurium.php
msgid ""
"Site hacked? Free WordPress malware removal: scan, clean infected files, "
"restore them. Plus firewall, brute-force protection, 2FA, geo-blocking."
msgstr ""
"Feltört a webhely? Ingyenes WordPress kártevőirtás: vizsgálat, fertőzött "
"fájlok tisztítása. Tűzfal, brute force védelem, 2FA, országblokkolás."


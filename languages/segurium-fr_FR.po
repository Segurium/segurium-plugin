msgstr "Cross-Origin-Resource-Policy"

#: includes/class-segurium.php:2185
msgid "Same site"
msgstr "Même site"

#: includes/class-segurium.php:2186
msgid "Cross origin"
msgstr "Cross-origin"

#: includes/class-segurium.php:2190
msgid "Cross-Origin-Embedder-Policy"
msgstr "Cross-Origin-Embedder-Policy"

#: includes/class-segurium.php:2192

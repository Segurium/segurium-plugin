msgstr "HSTS (Strict-Transport-Security)"

#: includes/class-segurium.php:2793
msgid "Enable HSTS"
msgstr "הפעלת HSTS"

#: includes/class-segurium.php:2795
msgid "Forces browsers to use HTTPS. Only sent when SSL is active."
msgstr "מכריח דפדפנים להשתמש ב-HTTPS. נשלח רק כאשר SSL פעיל."


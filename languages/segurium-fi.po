#. Plugin Name of the plugin
#: segurium.php
msgid ""
"Segurium – Free Malware Removal & Antivirus Scanner, Hacked Website Cleanup,"
" Firewall, 2FA"
msgstr ""
"Segurium – Maksuton haittaohjelmien poisto & virustorjunta, hakkeroidun "
"sivuston puhdistus, palomuuri, 2FA"

#. Plugin URI of the plugin
#: segurium.php
msgid "https://segurium.com"
msgstr "https://segurium.com"

#. Description of the plugin
#: segurium.php
msgid ""
"Website hacked? Free malware removal and antivirus scan for WordPress: clean"
" infected files, restore them. Firewall, brute force, 2FA included."
msgstr ""
"Sivusto hakkeroitu? Maksuton haittaohjelmien poisto ja virustarkistus "
"WordPressille: puhdista saastuneet tiedostot ja palauta ne."


msgstr "Жоден із %1$d cookies не встановлює атрибут %2$s."

#. translators: %d: total cookie count
#: includes/class-segurium-self-check.php:724
#, php-format
msgid "All %d cookies set SameSite=Lax/Strict."
msgstr "Усі %d cookies встановлюють SameSite=Lax/Strict."

#. translators: 1: good cookie count, 2: total cookie count
#: includes/class-segurium-self-check.php:738
#, php-format
msgid "%1$d of %2$d cookies set SameSite=Lax/Strict."
msgstr "%1$d із %2$d cookies встановлюють SameSite=Lax/Strict."

#. translators: 1: count of cookies using SameSite=None, 2: total cookie count
#: includes/class-segurium-self-check.php:746
#, php-format

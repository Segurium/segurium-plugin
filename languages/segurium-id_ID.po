msgstr "Gagal memulihkan berkas"

#: includes/class-segurium.php:4256 includes/class-segurium.php:4319
msgid "Invalid restore path"
msgstr "Jalur pemulihan tidak valid"

#: includes/class-segurium.php:4278 includes/class-segurium.php:7184
msgid "File restored from backup"
msgstr "Berkas dipulihkan dari cadangan"

#: includes/class-segurium.php:4314
msgid "Backup has no target path"
msgstr "Cadangan tidak punya jalur target"

#: includes/class-segurium.php:4336
msgid "Failed to read target file"
msgstr "Gagal membaca berkas target"

#: includes/class-segurium.php:4426
msgid "File is not an active malware entry."
msgstr "Berkas ini bukan entri malware yang aktif."

#: includes/class-segurium.php:4433

msgstr "A webhely nem HTTPS-en keresztül érhető el. A forgalom titkosítatlan."

#: includes/class-segurium-self-check.php:722
msgid ""
"No Set-Cookie headers on the homepage; cannot assess cookie flags from "
"outside."
msgstr ""
"A kezdőlapon nincs Set-Cookie fejléc; a sütik jelzői kívülről nem ítélhetők "
"meg."

#: includes/class-segurium-self-check.php:728
#: includes/class-segurium-self-check.php:761
msgid "Cookies — Secure"
msgstr "Sütik – Secure"

#: includes/class-segurium-self-check.php:739
#: includes/class-segurium-self-check.php:762
msgid "Cookies — HttpOnly"
msgstr "Sütik – HttpOnly"

#: includes/class-segurium-self-check.php:750
#: includes/class-segurium-self-check.php:858
#: includes/class-segurium-self-check.php:872
#: includes/class-segurium-self-check.php:890

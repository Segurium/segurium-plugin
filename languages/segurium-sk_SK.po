#: includes/class-segurium-scan-runner.php:1412
#: includes/class-segurium.php:4657
msgid "Could not fetch scan status due to a server error."
msgstr "Stav skenovania sa pre chybu servera nepodarilo načítať."

#. translators: %d: max_execution_time in seconds
#: includes/class-segurium-scan-runner.php:2339
#, php-format
msgid ""
"PHP max_execution_time is %ds — too short for reliable scanning. Ask your "
"host to raise it to at least 30s."
msgstr ""
"PHP max_execution_time je %d s – na spoľahlivé skenovanie príliš málo. "
"Požiadajte poskytovateľa hostingu, aby ho zvýšil aspoň na 30 s."

#: includes/class-segurium-scan-runner.php:2350
msgid ""
"WordPress cron is disabled (DISABLE_WP_CRON) and your PHP setup has no way "
"to detach long tasks from page requests. Background scans will only progress"
" while a Segurium admin tab stays open. Ask your host to either enable a "
"real system cron job hitting wp-cron.php every minute, or to switch from "
"mod_php to PHP-FPM / LiteSpeed."
msgstr ""
"Cron WordPress je vypnutý (DISABLE_WP_CRON) a vaše nastavenie PHP nedokáže "
"oddeliť dlhé úlohy od požiadaviek na stránky. Skenovanie na pozadí bude "
"pokračovať, len kým zostane otvorená karta administrácie Segurium. "
"Požiadajte poskytovateľa hostingu, aby zapol skutočnú systémovú úlohu cron, "
"ktorá každú minútu volá wp-cron.php, alebo aby prešiel z mod_php na PHP-FPM "
"/ LiteSpeed."

#: includes/class-segurium-scan-runner.php:2352
msgid ""
"WordPress cron is disabled (DISABLE_WP_CRON). Scheduled scans depend on a "
"real system cron job hitting wp-cron.php every minute. Ask your host to set "
"one up."
msgstr ""
"Cron WordPress je vypnutý (DISABLE_WP_CRON). Naplánované skenovanie závisí "
"od skutočnej systémovej úlohy cron, ktorá každú minútu volá wp-cron.php. "
"Požiadajte poskytovateľa hostingu, aby ju nastavil."

#: includes/class-segurium-scan-trigger-auth.php:93
#: includes/class-segurium-scan-trigger-auth.php:135
#: includes/class-segurium-scan-trigger-auth.php:143
msgid "Scan trigger requires authentication."
msgstr "Spustenie skenovania vyžaduje overenie."

#: includes/class-segurium-scan-trigger-auth.php:122
msgid "Scan trigger secret did not match."
msgstr "Tajný kľúč na spustenie skenovania sa nezhoduje."

#: includes/class-segurium-scheduled-scan-settings.php:114
msgid "Invalid settings payload."
msgstr "Neplatné údaje nastavení."

#: includes/class-segurium-scheduled-scan-settings.php:133
msgid "Frequency must be one of: off, daily, weekly."
msgstr "Frekvencia musí byť jedna z: off, daily, weekly."

#: includes/class-segurium-scheduled-scan-settings.php:144
msgid "Hour must be between 0 and 23."
msgstr "Hodina musí byť od 0 do 23."

#: includes/class-segurium-scheduled-scan-settings.php:155
msgid "Minute must be between 0 and 59."
msgstr "Minúta musí byť od 0 do 59."

#: includes/class-segurium-scheduled-scan-settings.php:166
msgid "Day of week must be between 0 (Sunday) and 6 (Saturday)."
msgstr "Deň v týždni musí byť od 0 (nedeľa) do 6 (sobota)."

#: includes/class-segurium-self-check.php:522
msgid ""
"This server re-adds the header after the plugin removes it. Open the feature"
" tab for the server-level fix."
msgstr ""
"Tento server hlavičku po odstránení pluginom znova pridá. Opravu na úrovni "
"servera nájdete na karte funkcie."

#: includes/class-segurium-self-check.php:711 includes/class-segurium.php:2900
msgid "Content-Security-Policy"
msgstr "Content-Security-Policy"

#: includes/class-segurium-self-check.php:714
msgid "CSP is enforced."
msgstr "CSP sa vynucuje."

#: includes/class-segurium-self-check.php:716
msgid "CSP is report-only. Switch to enforce for full protection."
msgstr ""
"CSP je len v režime hlásenia. Na úplnú ochranu prepnite na vynucovanie."

#: includes/class-segurium-self-check.php:717
msgid "No Content-Security-Policy header. Protects against XSS and injection."
msgstr ""
"Chýba hlavička Content-Security-Policy. Chráni pred XSS a vkladaním kódu."

#: includes/class-segurium-self-check.php:732
msgid "Strict-Transport-Security"
msgstr "Strict-Transport-Security"

#: includes/class-segurium-self-check.php:735
msgid "HSTS active with at least a one-year max-age."
msgstr "HSTS je aktívne s max-age aspoň jeden rok."

#: includes/class-segurium-self-check.php:737
msgid "HSTS present but max-age is below one year."
msgstr "HSTS je nastavené, ale max-age je kratší ako jeden rok."

#: includes/class-segurium-self-check.php:738
msgid "No HSTS header. Browsers may connect over plain HTTP."
msgstr ""
"Chýba hlavička HSTS. Prehliadače sa môžu pripojiť cez nezabezpečené HTTP."

#: includes/class-segurium-self-check.php:750
msgid "X-Content-Type-Options"
msgstr "X-Content-Type-Options"

#: includes/class-segurium-self-check.php:753
msgid "MIME sniffing prevented."
msgstr "Zisťovanie typu MIME je zablokované."

#: includes/class-segurium-self-check.php:754
msgid "Missing. Browsers may misinterpret file types."
msgstr "Chýba. Prehliadače môžu nesprávne určiť typ súboru."

#: includes/class-segurium-self-check.php:766 includes/class-segurium.php:2769
msgid "X-Frame-Options"
msgstr "X-Frame-Options"

#: includes/class-segurium-self-check.php:769
msgid "Clickjacking protection via X-Frame-Options."
msgstr "Ochrana pred clickjackingom pomocou X-Frame-Options."

#: includes/class-segurium-self-check.php:770
msgid "Missing X-Frame-Options. Site may be framed by attackers."
msgstr ""
"Chýba X-Frame-Options. Útočníci môžu vašu webovú stránku vložiť do rámca."

#: includes/class-segurium-self-check.php:782 includes/class-segurium.php:2777
msgid "Referrer-Policy"
msgstr "Referrer-Policy"

#: includes/class-segurium-self-check.php:785
msgid "Referrer-Policy restricts information leakage on navigation."
msgstr "Referrer-Policy obmedzuje únik informácií pri navigácii."

#: includes/class-segurium-self-check.php:786
msgid "Missing or unsafe Referrer-Policy. Full URLs may be leaked."
msgstr ""
"Referrer-Policy chýba alebo nie je bezpečná. Môžu uniknúť celé URL adresy."

#: includes/class-segurium-self-check.php:797 includes/class-segurium.php:2865
msgid "Permissions-Policy"
msgstr "Permissions-Policy"

#: includes/class-segurium-self-check.php:800
msgid "Permissions-Policy restricts access to browser features."
msgstr "Permissions-Policy obmedzuje prístup k funkciám prehliadača."

#: includes/class-segurium-self-check.php:801
msgid "Missing Permissions-Policy. Browser features are not restricted."
msgstr "Chýba Permissions-Policy. Funkcie prehliadača nie sú obmedzené."

#: includes/class-segurium-self-check.php:813 includes/class-segurium.php:2797
msgid "X-XSS-Protection"
msgstr "X-XSS-Protection"

#: includes/class-segurium-self-check.php:816
msgid "Legacy XSS filter directive present."
msgstr "Je prítomná zastaraná direktíva filtra XSS."

#: includes/class-segurium-self-check.php:817
msgid ""
"Missing X-XSS-Protection. Set to 0 to disable legacy browser XSS filters "
"safely."
msgstr ""

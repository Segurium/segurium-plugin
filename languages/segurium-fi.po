msgstr "Viikonpäivän on oltava välillä 0 (sunnuntai) ja 6 (lauantai)."

#: includes/class-segurium-self-check.php:401 includes/class-segurium.php:2924
msgid "Content-Security-Policy"
msgstr "Content-Security-Policy"

#: includes/class-segurium-self-check.php:404
msgid "CSP is enforced."
msgstr "CSP on pakotettu."

#: includes/class-segurium-self-check.php:406
msgid "CSP is report-only. Switch to enforce for full protection."
msgstr ""
"CSP on vain raportointitilassa. Vaihda pakotettuun täyttä suojaa varten."

#: includes/class-segurium-self-check.php:407
msgid "No Content-Security-Policy header. Protects against XSS and injection."
msgstr ""
"Ei Content-Security-Policy-otsaketta. Suojaa XSS:ltä ja koodin lisäykseltä."

#: includes/class-segurium-self-check.php:422
msgid "Strict-Transport-Security"
msgstr "Strict-Transport-Security"

#: includes/class-segurium-self-check.php:425
msgid "HSTS active with at least a one-year max-age."
msgstr "HSTS on käytössä ja sen max-age on vähintään vuosi."

#: includes/class-segurium-self-check.php:427
msgid "HSTS present but max-age is below one year."
msgstr "HSTS on paikallaan, mutta max-age on alle vuoden."

#: includes/class-segurium-self-check.php:428
msgid "No HSTS header. Browsers may connect over plain HTTP."
msgstr "Ei HSTS-otsaketta. Selaimet voivat yhdistää salaamattomalla HTTP:llä."

#: includes/class-segurium-self-check.php:440
msgid "X-Content-Type-Options"
msgstr "X-Content-Type-Options"

#: includes/class-segurium-self-check.php:443
msgid "MIME sniffing prevented."
msgstr "MIME-tyypin arvailu on estetty."

#: includes/class-segurium-self-check.php:444
msgid "Missing. Browsers may misinterpret file types."
msgstr "Puuttuu. Selaimet voivat tulkita tiedostotyypit väärin."

#: includes/class-segurium-self-check.php:456 includes/class-segurium.php:2793
msgid "X-Frame-Options"
msgstr "X-Frame-Options"

#: includes/class-segurium-self-check.php:459
msgid "Clickjacking protection via X-Frame-Options."
msgstr "Klikkikaappauksen suojaus X-Frame-Options-otsakkeella."

#: includes/class-segurium-self-check.php:460
msgid "Missing X-Frame-Options. Site may be framed by attackers."
msgstr "X-Frame-Options puuttuu. Hyökkääjä voi upottaa sivuston kehykseen."

#: includes/class-segurium-self-check.php:472 includes/class-segurium.php:2801
msgid "Referrer-Policy"
msgstr "Referrer-Policy"

#: includes/class-segurium-self-check.php:475
msgid "Referrer-Policy restricts information leakage on navigation."
msgstr "Referrer-Policy rajoittaa tiedon vuotamista siirryttäessä."

#: includes/class-segurium-self-check.php:476
msgid "Missing or unsafe Referrer-Policy. Full URLs may be leaked."
msgstr ""
"Referrer-Policy puuttuu tai on turvaton. Koko verkko-osoite voi vuotaa."

#: includes/class-segurium-self-check.php:487 includes/class-segurium.php:2889
msgid "Permissions-Policy"
msgstr "Permissions-Policy"

#: includes/class-segurium-self-check.php:490
msgid "Permissions-Policy restricts access to browser features."
msgstr "Permissions-Policy rajoittaa pääsyä selaimen ominaisuuksiin."

#: includes/class-segurium-self-check.php:491
msgid "Missing Permissions-Policy. Browser features are not restricted."
msgstr "Permissions-Policy puuttuu. Selaimen ominaisuuksia ei ole rajoitettu."

#: includes/class-segurium-self-check.php:503 includes/class-segurium.php:2821
msgid "X-XSS-Protection"
msgstr "X-XSS-Protection"

#: includes/class-segurium-self-check.php:506
msgid "Legacy XSS filter directive present."
msgstr "Vanha XSS-suodattimen määre on paikallaan."

#: includes/class-segurium-self-check.php:507
msgid ""
"Missing X-XSS-Protection. Set to 0 to disable legacy browser XSS filters "
"safely."
msgstr ""
"X-XSS-Protection puuttuu. Aseta arvoksi 0, jotta vanhojen selainten XSS-"
"suodattimet poistetaan turvallisesti käytöstä."

#: includes/class-segurium-self-check.php:532
msgid "X-Powered-By hidden"
msgstr "X-Powered-By piilotettu"

#. translators: %s: header value
#: includes/class-segurium-self-check.php:537
#, php-format
msgid "X-Powered-By reveals: %s"
msgstr "X-Powered-By paljastaa: %s"

#: includes/class-segurium-self-check.php:540
msgid "X-Powered-By header is not exposed."
msgstr "X-Powered-By-otsaketta ei paljasteta."

#: includes/class-segurium-self-check.php:551
msgid "WordPress version hidden"
msgstr "WordPress-versio piilotettu"

#: includes/class-segurium-self-check.php:554
msgid "WordPress version exposed in HTML source."
msgstr "WordPress-versio näkyy HTML-lähdekoodissa."

#: includes/class-segurium-self-check.php:555
msgid "WordPress version not visible in HTML."
msgstr "WordPress-versio ei näy HTML:ssä."

#: includes/class-segurium-self-check.php:566
msgid "Asset version query hidden"
msgstr "Resurssien versiokysely piilotettu"

#: includes/class-segurium-self-check.php:569
msgid "Core/theme/plugin version exposed in ?ver= on asset URLs."
msgstr ""
"Ytimen, teeman tai lisäosan versio näkyy resurssien verkko-osoitteiden "
"?ver=-osassa."

#: includes/class-segurium-self-check.php:570
msgid "Asset URLs do not expose version numbers."
msgstr "Resurssien verkko-osoitteet eivät paljasta versionumeroita."

#: includes/class-segurium-self-check.php:597
msgid "XML-RPC disabled"
msgstr "XML-RPC poistettu käytöstä"

#: includes/class-segurium-self-check.php:600
msgid "XML-RPC endpoint is disabled."
msgstr "XML-RPC-päätepiste on poistettu käytöstä."

#: includes/class-segurium-self-check.php:601
msgid ""
"XML-RPC is reachable. A frequent brute-force and pingback-amplification "
"target."
msgstr ""
"XML-RPC on tavoitettavissa. Yleinen kohde raa'an voiman hyökkäyksille ja "
"paluuviitteiden vahvistushyökkäyksille."

#: includes/class-segurium-self-check.php:612
msgid "REST API discovery disabled"
msgstr "REST-rajapinnan löytäminen poistettu käytöstä"

#: includes/class-segurium-self-check.php:615
msgid "REST API discovery link removed from <head>."
msgstr "REST-rajapinnan löytämislinkki on poistettu <head>-osasta."

#: includes/class-segurium-self-check.php:616
msgid "REST API discovery link exposed — simplifies reconnaissance."
msgstr ""
"REST-rajapinnan löytämislinkki on näkyvissä — se helpottaa tiedustelua."

#: includes/class-segurium-self-check.php:627
msgid "Brute-force protection"
msgstr "Raa'an voiman suojaus"

#: includes/class-segurium-self-check.php:630
msgid "Login brute-force protection is active."
msgstr "Kirjautumisen raa'an voiman suojaus on käytössä."

#: includes/class-segurium-self-check.php:631
msgid "Brute-force protection is disabled."
msgstr "Raa'an voiman suojaus on poistettu käytöstä."

#: includes/class-segurium-self-check.php:646
msgid "Two-factor enforced for administrators"
msgstr "Kaksivaiheinen tunnistautuminen pakotettu ylläpitäjille"

#: includes/class-segurium-self-check.php:649
msgid "Two-factor authentication is enforced for the administrator role."
msgstr "Kaksivaiheinen tunnistautuminen on pakotettu ylläpitäjän roolille."

#: includes/class-segurium-self-check.php:650
msgid "Administrators can log in with a password alone."
msgstr "Ylläpitäjät voivat kirjautua pelkällä salasanalla."

#: includes/class-segurium-self-check.php:662 includes/class-segurium.php:2064
msgid "Firewall"
msgstr "Palomuuri"

#: includes/class-segurium-self-check.php:665
msgid "Firewall rules are active."
msgstr "Palomuurin säännöt ovat käytössä."

#: includes/class-segurium-self-check.php:666
msgid "No firewall rules are active."
msgstr "Yhtään palomuurin sääntöä ei ole käytössä."

#: includes/class-segurium-self-check.php:678
msgid "HTTPS / SSL active"
msgstr "HTTPS / SSL käytössä"

#: includes/class-segurium-self-check.php:681
msgid "Site is served over HTTPS."
msgstr "Sivusto tarjoillaan HTTPS-yhteydellä."

#: includes/class-segurium-self-check.php:682
msgid "Site is not served over HTTPS. Traffic is unencrypted."
msgstr "Sivustoa ei tarjoilla HTTPS-yhteydellä. Liikenne on salaamatonta."

#: includes/class-segurium-self-check.php:722
msgid ""
"No Set-Cookie headers on the homepage; cannot assess cookie flags from "
"outside."
msgstr ""
"Etusivulla ei ole Set-Cookie-otsakkeita; evästeiden lippuja ei voi arvioida "
"ulkopuolelta."

#: includes/class-segurium-self-check.php:728
#: includes/class-segurium-self-check.php:750
msgid "Cookies — Secure"
msgstr "Evästeet — Secure"

#: includes/class-segurium-self-check.php:739
#: includes/class-segurium-self-check.php:846
#: includes/class-segurium-self-check.php:860
#: includes/class-segurium-self-check.php:878
msgid "Cookies — SameSite"
msgstr "Evästeet — SameSite"

#. translators: 1: total cookie count, 2: cookie attribute name
#: includes/class-segurium-self-check.php:782
#, php-format
msgid "All %1$d cookies set the %2$s attribute."
msgstr "Kaikki %1$d evästettä asettavat %2$s-attribuutin."

#. translators: 1: matching cookie count, 2: total cookie count, 3: cookie
#. attribute name
#: includes/class-segurium-self-check.php:796
#, php-format
msgid "%1$d of %2$d cookies set %3$s."
msgstr "%1$d / %2$d evästettä asettaa %3$s."

#. translators: 1: total cookie count, 2: cookie attribute name
#: includes/class-segurium-self-check.php:809
#, php-format
msgid "None of the %1$d cookies set the %2$s attribute."
msgstr "Yksikään %1$d evästeestä ei aseta %2$s-attribuuttia."

#. translators: %d: total cookie count
#: includes/class-segurium-self-check.php:849
#, php-format
msgid "All %d cookies set SameSite=Lax/Strict."
msgstr "Kaikki %d evästettä asettavat SameSite=Lax/Strict."

#. translators: 1: good cookie count, 2: total cookie count
#: includes/class-segurium-self-check.php:863
#, php-format
msgid "%1$d of %2$d cookies set SameSite=Lax/Strict."
msgstr "%1$d / %2$d evästettä asettaa SameSite=Lax/Strict."

#. translators: 1: count of cookies using SameSite=None, 2: total cookie count
